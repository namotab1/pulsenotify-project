  "item": [
    {
      "name": "Register a new user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Response has access token and role is user\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property(\"access\");",
              "    pm.expect(body.role).to.eql(\"user\");",
              "});",
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set(\"user_token\", pm.response.json().access);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"alice\", \"password\": \"securepass\", \"email\": \"alice@example.com\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register",
            ""
          ]
        },
        "description": "Public endpoint. Returns 201 with username, JWT access token and role ('user'). Only returns 201 on a fresh database; re-running it returns 400 (see the next request)."
      },
      "response": []
    },
