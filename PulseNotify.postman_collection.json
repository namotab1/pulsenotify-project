    {
      "name": "Helper - Register admin user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Admin user registered (201) or already exists (400)\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([201, 400]);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set(\"admin_token\", pm.response.json().access);",
              "} else if (pm.response.code === 400) {",
              "    pm.sendRequest({",
              "        url: pm.collectionVariables.get(\"base_url\") + \"/api/auth/login/\",",
              "        method: \"POST\",",
              "        header: [{ key: \"Content-Type\", value: \"application/json\" }],",
              "        body: {",
              "            mode: \"raw\",",
              "            raw: JSON.stringify({ username: \"adminuser\", password: \"securepass\" })",
              "        }",
              "    }, function (err, response) {",
              "        if (!err && response && response.code === 200) {",
              "            pm.collectionVariables.set(\"admin_token\", response.json().access);",
              "        } else {",
              "            console.error(\"Could not log in as adminuser\", err);",
              "        }",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"adminuser\", \"password\": \"securepass\", \"email\": \"admin@example.com\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register",
            ""
          ]
        },
        "description": "Not one of the 13 scenarios. Registers 'adminuser' and saves the token to {{admin_token}}. If the user already exists (400) it logs in instead. New users always start with role 'user', so promote adminuser once from the Django shell before running the admin summary requests:\n\npython manage.py shell\nfrom pulse.models import UserProfile\np = UserProfile.objects.get(user__username='adminuser'); p.role = 'admin'; p.save()"
      },
      "response": []
    },
